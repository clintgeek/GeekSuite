# Copy to .env.production (prod) or backend/.env.local (dev). Names and
# placeholders only — never commit real values.

# Mongo for this backend's own writes (file records, photo/document entries,
# the trash purge). Database `thinggeek`; collections `things` and `files`
# are shared with basegeek's gateway via @geeksuite/schemas/thinggeek.
MONGODB_URI=mongodb://user:password@host:27017/thinggeek?authSource=admin

# Suite JWT signing secret. Sessions are checked through basegeek
# (@geeksuite/user/server attachUser); kept for parity with every consumer.
JWT_SECRET=change-me

# basegeek origin: /api/auth/* proxy and session checks.
BASEGEEK_URL=https://basegeek.clintgeek.com
# Optional: override the 8s timeout on calls to basegeek.
# BASEGEEK_TIMEOUT_MS=8000

# Where photo/document bytes live. Compose sets /data/files (bind-mounted to
# apps/thinggeek/data/files); override only for local dev outside Docker.
FILES_PATH=/data/files

# debug | info | warn | error. Defaults to debug in dev, info in production.
LOG_LEVEL=info

# CSRF origin guard mode: enforce (default) | report | off.
# CSRF_GUARD=enforce

# Optional: comma-separated CORS/CSRF allow-list. Defaults to
# thinggeek.clintgeek.com + localhost dev origins — see backend/src/app.js.
# CORS_ORIGINS=https://thinggeek.clintgeek.com,http://localhost:1821

# Trash purge (daily, production only). 1 = kill switch.
# PURGE_DISABLED=1
# Run the schedule outside production too (dev only).
# PURGE_AUTORUN=1
