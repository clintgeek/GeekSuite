# Copy to .env.production (prod) or backend/.env.local (dev). Names and
# placeholders only — never commit real values.

# production | development. Compose sets production.
NODE_ENV=production

# Listen port. Compose sets 1840; Vite's dev server is 1841.
PORT=1840

# basegeek origin: /api/auth/* proxy and session checks. GeekDay has no
# database and does not verify JWTs itself, so there is no JWT_SECRET here
# (@geeksuite/user/server asks basegeek).
BASEGEEK_URL=https://basegeek.clintgeek.com
# Optional: override the 8s timeout on calls to basegeek.
# BASEGEEK_TIMEOUT_MS=8000

# Optional: comma-separated CORS/CSRF allow-list. Defaults to
# geekday.clintgeek.com + localhost:1841/1840 — see backend/src/app.js.
# CORS_ORIGINS=https://geekday.clintgeek.com,http://localhost:1841

# CSRF origin guard mode: enforce (default) | report | off.
CSRF_GUARD=enforce

# debug | info | warn | error. Defaults to debug in dev, info in production.
LOG_LEVEL=info
