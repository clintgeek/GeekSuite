{
  "name": "storygeek-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "StoryGeek backend API for AI-powered storytelling game",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "npm run test:node && npm run test:jest",
    "test:node": "node --test src/__tests__/*.test.js",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:campaign": "node --test src/__tests__/campaign.test.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@geeksuite/user": "workspace:*",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "pino-pretty": "^11.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@geeksuite/eslint-config": "workspace:*",
    "@jest/globals": "29.7.0",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "storytelling",
    "ai",
    "game",
    "dnd",
    "fantasy"
