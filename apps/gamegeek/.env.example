# Copy to .env.production (prod) or .env.local (dev). Names and placeholders
# only — never commit real values. See DOCS/GameGeekPlan.md §9 row 15.

# Mongo connection string for this backend's own writes (covers, imports).
# Same collections (games/gameplayers/gameprofiles) basegeek's GraphQL
# gateway writes plain data to — see @geeksuite/schemas/gamegeek.
MONGODB_URI=mongodb://user:password@host:27017/gamegeek?authSource=admin

# Suite JWT signing secret. Shared across apps; this backend doesn't verify
# JWTs itself (session checks go through basegeek — see
# @geeksuite/user/server's attachUser), but it's part of every consumer
# backend's env for parity with the rest of the suite.
JWT_SECRET=change-me

# basegeek origin this backend proxies /api/auth/* and session checks to.
BASEGEEK_URL=https://basegeek.clintgeek.com
# Optional: override the 8s default timeout on calls to basegeek.
# BASEGEEK_TIMEOUT_MS=8000

# Optional: comma-separated CORS/CSRF allow-list. Defaults to
# gamegeek.clintgeek.com + localhost dev origins when unset — see src/app.js.
# CORS_ORIGINS=https://gamegeek.clintgeek.com,http://localhost:1811

# CSRF origin guard mode: enforce (default) | report | off.
# CSRF_GUARD=enforce

# IGDB (Twitch developer application) — metadata search/covers. Unset means
# GameGeek falls back to the keyless Steam store search.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# debug | info | warn | error. Defaults to debug in dev, info in production.
LOG_LEVEL=info

# Where cover files are written. Matches the compose bind mount
# (./data/covers:/data/covers) — override only for local dev outside Docker.
# COVERS_PATH=/data/covers
