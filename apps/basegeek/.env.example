# Example environment file for BaseGeek / DataGeek stack
# Copy to `.env`, `.env.local`, or `.env.production` and adjust per environment.

# Application Ports
PORT=8987
UI_PORT=8988

# JWT Secrets (replace with secure values before running anything)
JWT_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=30d

# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# Public URL this instance answers on (used to build callback/reference links).
BASEGEEK_URL=https://basegeek.clintgeek.com

# MongoDB Connection Details
MONGO_INITDB_ROOT_USERNAME=datageek_admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGODB_URI=mongodb://datageek_admin:CHANGE_ME@localhost:27018
MONGODB_DB_NAME=datageek
MONGO_BASE_URI=mongodb://datageek_admin:CHANGE_ME@localhost:27018
USERGEEK_MONGODB_URI=mongodb://datageek_admin:CHANGE_ME@localhost:27018/userGeek?authSource=admin
AIGEEK_MONGODB_URI=mongodb://datageek_admin:CHANGE_ME@localhost:27018/aiGeek?authSource=admin

# Encrypts API keys at rest (basegeek) and the Garmin password at rest
# (fitnessgeek, via the shared UserSettings schema) — REQUIRED, no default.
# Copy the same value into fitnessgeek's .env.production; see DEPLOY.md
# "Shared secrets across apps". Losing this makes every encrypted value
# unrecoverable — store it in a password manager.
KEY_VAULT_SECRET=replace_with_64_hex_chars

# SSO cookie domain — must be the shared parent domain so every
# *.clintgeek.com subdomain receives the cookie. See DOCS/CONTEXT.md.
SSO_COOKIE_DOMAIN=.clintgeek.com

# CSRF (see DOCS/CONTEXT.md "CSRF: the double-submit token").
# CSRF_GUARD: off|report (Origin allow-list guard, all seven backends).
# CSRF_TOKEN: off|report|enforce (double-submit token, basegeek only).
# Either var unset or unrecognized defaults to report, not enforce.
CSRF_GUARD=report
CSRF_TOKEN=report

# Redis Connection
REDIS_URL=redis://localhost:6380

# PostgreSQL Connection Details
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=datageek_pg_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=datageek
POSTGRES_URL=postgres://datageek_pg_admin:CHANGE_ME@localhost:55432/datageek

# InfluxDB Connection Details
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=basegeek
INFLUXDB_BUCKET=datageek_metrics
INFLUXDB_TOKEN=replace_with_scoped_token
INFLUXDB_SETUP_USERNAME=datageek_influx_admin
INFLUXDB_SETUP_PASSWORD=CHANGE_ME_SET_INFLUXDB_PASSWORD
INFLUXDB_ADMIN_TOKEN=replace_with_bootstrap_token

# OAuth providers (for /api/connections household OAuth tokens)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://basegeek.clintgeek.com/api/connections/google/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://basegeek.clintgeek.com/api/connections/spotify/callback

# Internal service-to-service JWT (dashgeek backend → basegeek /connections/internal)
INTERNAL_JWT_SECRET=

# BuJoGeek task reminders (web push).
# Generate a pair once with `npx web-push generate-vapid-keys` and keep the
# private half secret. With either key missing the reminder scheduler logs a
# line and stays off — the app degrades to "no reminders", never to an error.
# VAPID_SUBJECT must be a mailto: (or https:) URL identifying the sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# AI response cache (aiService). Both optional — omit to take the defaults.
# The cache is bounded on both axes so a long-lived process neither serves
# stale completions forever nor grows without limit under prompt churn.
AI_CACHE_MAX_ENTRIES=500
AI_CACHE_TTL_MS=1800000

# Ambient weather (dashgeek ambient screen, Open-Meteo — no API key required)
WEATHER_LAT=
WEATHER_LON=
