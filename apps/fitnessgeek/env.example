# FitnessGeek Environment Variables
# Copy to `.env.production` and fill in real values. Names here must match
# what apps/fitnessgeek/backend/src actually reads (verified 2026-09-05) — see
# DOCS/RUNBOOK.md's fitnessgeek row for the authoritative per-app list.

# Server
PORT=3001
NODE_ENV=production
APP_NAME=fitnessgeek
LOG_LEVEL=info
CORS_ORIGINS=

# Database (Mongoose — was wrongly named DB_URI here; the code reads MONGODB_URI)
MONGODB_URI=mongodb://username:password@host:port/database

# JWT — verified locally with the shared suite JWT_SECRET (see DOCS/SSO_OVERVIEW.md).
# JWT_REFRESH_SECRET is basegeek-only (DEPLOY.md "Shared secrets across apps") —
# fitnessgeek does not read it.
JWT_SECRET=your-jwt-secret-here
LOCAL_AUTH_COOKIE_DOMAIN=

# baseGeek Integration
BASEGEEK_URL=https://basegeek.clintgeek.com

# Redis (session/cache)
REDIS_URL=redis://localhost:6380

# Encrypts the Garmin password at rest (shared UserSettings schema). Must be
# the exact same value as basegeek's KEY_VAULT_SECRET — DEPLOY.md "Shared
# secrets across apps".
KEY_VAULT_SECRET=replace_with_basegeeks_value

# aiGeek service key — the one credential this backend needs for AI.
#
# Minted on the baseGeek host with `ai:call`; every AI feature (food parse,
# classification, result scoring, insights, coaching, chat, nutrition goals,
# meal plan) goes through `POST /api/ai/feature` with it, and aiGeek resolves
# the calling app from the key. No provider keys and no model ids live here:
# routing is the AIAppConfig row for app `fitnessgeek`.
#
# Unset is a supported state — every feature falls back to its deterministic
# answer or a friendly "the assistant isn't available right now".
AI_GEEK_API_KEY=

# Food API Keys (Optional — each provider degrades gracefully if unset)
USDA_API_KEY=your-usda-api-key
OPENFOODFACTS_API_URL=https://world.openfoodfacts.org
CALORIENINJAS_API_KEY=your-calorieninjas-api-key
FATSECRET_CLIENT_ID=your-fatsecret-client-id
FATSECRET_CLIENT_SECRET=your-fatsecret-client-secret

# Food search tuning
MAX_SANITY_RESULTS=10
USER_PREFERENCE_LIMIT=20

# InfluxDB Configuration (Garmin health metrics)
INFLUXDB_HOST=192.168.1.17
INFLUXDB_PORT=8086
INFLUXDB_PROTOCOL=http
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=your-influxdb-password
INFLUXDB_DATABASE=geekdata
