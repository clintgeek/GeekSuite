# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitnessgeek
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here

# Server Configuration
PORT=3001
NODE_ENV=development

# External Food APIs
# ------------------

# USDA FoodData Central (required for raw ingredient accuracy)
# Get key at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_api_key

# OpenFoodFacts (no key required - free unlimited access)
OPENFOODFACTS_API_URL=https://world.openfoodfacts.org

# FatSecret API (branded food data - 5,000 calls/day free)
# Get credentials at: https://platform.fatsecret.com
FATSECRET_CLIENT_ID=your_client_id
FATSECRET_CLIENT_SECRET=your_client_secret

# CalorieNinjas API (optional fallback - 10,000 calls/month free)
# Get key at: https://calorieninjas.com/api
CALORIENINJAS_API_KEY=your_calorieninjas_key

# Secret encryption at rest
# ------------------------
# KEY_VAULT_SECRET encrypts the Garmin Connect password before it is written to
# MongoDB (AES-256-GCM via @geeksuite/crypto-vault). Format: exactly 64
# hexadecimal characters = 32 bytes. Generate with: openssl rand -hex 32
#
# It MUST be the same value basegeek is configured with — basegeek's GraphQL
# gateway reads and writes this same field. The server refuses to boot without
# it. Losing or rotating it makes every stored Garmin password undecryptable;
# users would have to re-enter them.
KEY_VAULT_SECRET=64_hex_characters_here

# baseGeek Integration
BASEGEEK_URL=https://basegeek.clintgeek.com
JWT_SECRET=CHANGE_ME_SET_JWT_SECRET

# Logging
LOG_LEVEL=info

# InfluxDB Configuration (for direct Garmin data access)
INFLUXDB_PROTOCOL=http
INFLUXDB_HOST=192.168.1.17
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=your_password
INFLUXDB_DATABASE=geekdata