# Copy to .env.production (prod) or backend/.env.local (dev). Names and
# placeholders only — never commit real values.

# Mongo for this backend's own writes (feed poll state, articles, the seed,
# the retention purge). Database `newsgeek`; collections `sources`, `places`
# and `articles` are shared with basegeek's gateway via
# @geeksuite/schemas/newsgeek.
MONGODB_URI=mongodb://user:password@host:27017/newsgeek?authSource=admin

# Suite JWT signing secret. Sessions are checked through basegeek
# (@geeksuite/user/server attachUser); kept for parity with every consumer.
JWT_SECRET=change-me

# basegeek origin: /api/auth/* proxy and session checks.
BASEGEEK_URL=https://basegeek.clintgeek.com
# Optional: override the 8s timeout on calls to basegeek.
# BASEGEEK_TIMEOUT_MS=8000

# debug | info | warn | error. Defaults to debug in dev, info in production.
LOG_LEVEL=info

# CSRF origin guard mode: enforce (default) | report | off.
# CSRF_GUARD=enforce

# Optional: comma-separated CORS/CSRF allow-list. Defaults to
# newsgeek.clintgeek.com + localhost dev origins — see backend/src/app.js.
# CORS_ORIGINS=https://newsgeek.clintgeek.com,http://localhost:1831

# Ingest worker (ticks every 60 s, production only). 1 = kill switch.
# INGEST_DISABLED=1
# Run the worker outside production too (dev only — it polls REAL feeds;
# be polite, and remember malvern-online.com 429s after 3–4 requests a minute).
# INGEST_AUTORUN=1
# Feeds in flight at once (never more than one per host). Default 4.
# INGEST_CONCURRENCY=4

# Article retention purge (daily, production only). 1 = kill switch.
# PURGE_DISABLED=1
# Run the schedule outside production too (dev only).
# PURGE_AUTORUN=1
